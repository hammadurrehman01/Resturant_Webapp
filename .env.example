# API base URL — leave blank to use the Vite dev proxy ("/api/v1").
VITE_API_BASE_URL=
VITE_API_PREFIX=/api/v1

# In dev, requests to /api are proxied to this backend (see vite.config.js).
VITE_API_PROXY_TARGET=http://localhost:4000

# Restaurant slug used by the public site to identify which restaurant to load.
# Single-tenant today; will become URL- or subdomain-driven when SaaS lands.
VITE_RESTAURANT_SLUG=karachi-tandoor
